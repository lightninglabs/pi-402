{
	"name": "@lightninglabs/pi-402",
	"version": "0.0.1",
	"description": "Pay for Pi inference with Lightning: an L402 + walletdk extension for the Pi coding agent",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lightninglabs/pi-402.git"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"check": "biome check --write --error-on-warnings . && tsc --noEmit",
		"test": "node --test 'test/**/*.test.ts'",
		"format": "biome format --write .",
		"clean": "echo 'nothing to clean'"
	},
	"dependencies": {
		"@lightninglabs/aperture-client": "^0.0.1",
		"@lightninglabs/aperture-core": "^0.0.1",
		"openai": "6.26.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
