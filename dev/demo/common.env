# Settings shared by both demo profiles. Sourced by demo-up.sh before the
# profile file, so anything here can be overridden per network.

# Where the demo keeps its state: wallet data dirs, databases, logs, and the
# pi-402 token cache and receipt ledger.
DEMO_DIR="${DEMO_DIR:-$HOME/.pi402-demo}"

# The model on stage, and the price ceiling pi will pay for one bundle. The
# default per-request cap is 1000 sats, which is below the ~11,500 a 1M-token
# Kimi K3 bundle quotes at, so leaving this unset rejects the payment.
DEMO_MODEL="l402-baseten/kimi-k3"
PI402_MAX_SAT_PER_REQUEST=20000
PI402_DAILY_CAP_SAT=100000

# The seller: aperture in front of Baseten, priced by lightmeter.
APERTURE_ADDR="127.0.0.1:8404"
LIGHTMETER_ADDR="127.0.0.1:10025"

# The two wallets. The buyer is pi's; the seller is the one aperture mints its
# challenge invoices from. Ports avoid waved's defaults (10029/10031) so a
# personal wallet already running on this machine is left alone.
BUYER_RPC="localhost:10039"
BUYER_GATEWAY_HOST="localhost:10041"
SELLER_RPC="localhost:10059"
SELLER_GATEWAY_HOST="localhost:10061"

# Wallet password for the demo wallets. Both are throwaway.
PI402_WALLET_PASSWORD="pi402-dev-password"

# Binaries. Override if yours live elsewhere.
WAVED_BIN="${WAVED_BIN:-$HOME/gocode/src/github.com/lightninglabs/wavelength-v010/bin/waved}"
APERTURE_BIN="${APERTURE_BIN:-$DEMO_DIR/bin/aperture}"
LIGHTMETER_BIN="${LIGHTMETER_BIN:-$DEMO_DIR/bin/lightmeterd}"

# The extension pi loads. Defaults to this checkout.
PI402_EXT="${PI402_EXT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"

# Aperture reads the Baseten credential from its own environment, so it never
# lands in a config file and pi never sees it. Export this before running.
BASETEN_ENV_VAR="${BASETEN_ENV_VAR:-BASETEN_GLM_5_2}"
