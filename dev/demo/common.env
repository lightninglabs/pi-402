# Settings shared by both demo profiles. Sourced by demo-up.sh before the
# profile file, so anything here can be overridden per network.

# Where this file lives, resolved under bash and zsh alike. The scripts run
# under bash, but this file is also sourced straight from an interactive
# shell, which here is zsh, and zsh sets no BASH_SOURCE. Falling back to an
# empty path silently resolves PI402_EXT to whatever is two levels above the
# current directory, so pi loads no extension and reports the model as simply
# not existing.
_demo_common_src="${BASH_SOURCE[0]:-${(%):-%x}}"
DEMO_COMMON_DIR="$(cd "$(dirname "$_demo_common_src")" && pwd)"
unset _demo_common_src

# Where the demo keeps its state: wallet data dirs, databases, logs, and the
# pi-402 token cache and receipt ledger.
DEMO_DIR="${DEMO_DIR:-$HOME/.pi402-demo}"

# The model on stage, and the price ceiling pi will pay for one bundle. The
# default per-request cap is 1000 sats, which is below the ~11,500 a 1M-token
# Kimi K3 bundle quotes at, so leaving this unset rejects the payment.
DEMO_MODEL="l402-baseten/kimi-k3"
PI402_MAX_SAT_PER_REQUEST=20000

# Deliberately generous for a demo. The daily counter lives in the pi process
# and is compared as max(in-memory, ledger), so clearing the receipt ledger
# between takes does not reset it: only restarting pi does. At ~11,500 a
# bundle the stock 100,000 cap refuses the ninth paid run of a session, which
# would land as a budget error in front of a room rather than during a
# rehearsal. Keep the per-request cap tight, since that is the one that
# actually bounds a single mistake.
PI402_DAILY_CAP_SAT=1000000

# Ports live in the profile files, not here, so both profiles can run at the
# same time: signet on stage with regtest still up behind it as a fallback you
# can switch to without rebuilding anything. Sharing one set of ports would
# mean tearing one down to bring the other up, which is the opposite of what a
# fallback is for.

# Wallet password for the demo wallets. Both are throwaway.
PI402_WALLET_PASSWORD="pi402-dev-password"

# Binaries. Override if yours live elsewhere.
WAVED_BIN="${WAVED_BIN:-$HOME/gocode/src/github.com/lightninglabs/wavelength-v010/bin/waved}"
APERTURE_BIN="${APERTURE_BIN:-$DEMO_DIR/bin/aperture}"
LIGHTMETER_BIN="${LIGHTMETER_BIN:-$DEMO_DIR/bin/lightmeterd}"

# The extension pi loads: the checkout this file belongs to.
PI402_EXT="${PI402_EXT:-$(cd "$DEMO_COMMON_DIR/../.." && pwd)}"

# Aperture reads the Baseten credential from its own environment, so it never
# lands in a config file and pi never sees it. Export this before running.
BASETEN_ENV_VAR="${BASETEN_ENV_VAR:-BASETEN_GLM_5_2}"
