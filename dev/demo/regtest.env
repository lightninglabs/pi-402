# Regtest profile: the fallback, for when signet or the network is unwell.
#
# Everything is local, which is the point: the lumos compose stack supplies the
# chain, the Ark operator, the swap server and an lnd to fund the buyer from.
DEMO_PROFILE="regtest"
PI402_NETWORK="regtest"

# The lumos compose stack has to be up for this profile.
DEMO_NEEDS_DOCKER="yes"
LUMOS_DIR="${LUMOS_DIR:-$HOME/gocode/src/github.com/lightninglabs/lumos-v010}"

# Regtest has no default endpoints, so every one is spelled out. Esplora is the
# compose stack's electrs, published on 8501.
WAVED_NET_FLAGS="--network=regtest \
  --wallet.esploraurl=http://localhost:8501 \
  --server.host=localhost:7070 --server.insecure \
  --swap.serveraddress=localhost:10030 --swap.serverinsecure"

APERTURE_CONFIG="aperture.regtest.yaml"
LIGHTMETER_CONFIG="lightmeter.regtest.yaml"

DEMO_FUNDING="local lnd-server pays the buyer's /fund invoice (see demo-fund.sh)"
