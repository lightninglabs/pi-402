# Signet profile: the one to demo on.
#
# There is no local chain infrastructure here at all. Both wallets talk to the
# public signet Ark operator and swap server that waved already defaults to,
# and aperture mints its challenge invoices from the seller wallet rather than
# an lnd node, so nothing on this machine needs a Lightning node, a channel, or
# inbound liquidity.
DEMO_PROFILE="signet"
PI402_NETWORK="signet"

# No docker: the operator, swap server and chain source are all hosted.
DEMO_NEEDS_DOCKER="no"

# waved resolves the signet operator, swap server and esplora endpoints from
# its own defaults, so the profile passes none of them.
WAVED_NET_FLAGS="--network=signet"

APERTURE_CONFIG="aperture.signet.yaml"
LIGHTMETER_CONFIG="lightmeter.signet.yaml"

# The buyer is funded from the Wavelength app, not from a local node.
DEMO_FUNDING="wavelength app (/fund <sats>, then pay from the app)"
